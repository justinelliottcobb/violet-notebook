    "@mantine/core": "^7.15.1",
    "@mantine/hooks": "^7.15.1",
    "bcryptjs": "^2.4.3",
    "codemirror": "^6.0.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.0.0-beta.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "isbot": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.4",
